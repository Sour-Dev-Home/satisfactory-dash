PORT=3001

# Optional: write logs to daily files (backend-YYYY-MM-DD.log) in this directory, keeping 14 days,
# instead of stdout. An absolute path; created if missing. See docs-vault/wiki/runbooks/go-live-api.md.
# LOG_DIR=
# Event loop diagnostic: once per 30 s window, log ONE warn `event_loop_stall` (max_ms, p99_ms, mean_ms)
# when the loop's worst delay exceeded this many ms (50-60000, default 500). Helps tell a machine-wide
# stall from this process being blocked.
# EVENT_LOOP_STALL_MS=500

# Postgres (ADR-0025). Optional until deploy A: unset or blank = no database. The runtime role is
# satis_app; see docs-vault/wiki/runbooks/database.md. Never commit a real value.
# DATABASE_URL=postgres://satis_app:CHANGE_ME@localhost:5432/satis
# DATABASE_POOL_MAX=10
# DATABASE_STATEMENT_TIMEOUT_MS=10000

# Satisfactory dedicated server connection (see backend/src/modules/gameserver/connectionConfig.ts)
# ADR-0001: the one registered game server. The id appears in every data URL
# (/api/servers/<id>/...): 1-32 lowercase letters, digits or dashes. The name is what
# the dashboard shows. Never put a host or port in either.
SATISFACTORY_SERVER_ID=default
# Optional: serve several game servers from a git-ignored JSON file (copy servers.example.json).
# When set, it replaces the single-server SATISFACTORY_* values below.
# SATISFACTORY_SERVERS_FILE=servers.json
SATISFACTORY_SERVER_NAME=Satisfactory server
# Must be loopback or a private IP (the backend refuses to start otherwise): the FRM
# web server speaks plain HTTP only, so its token must not cross a public network.
SATISFACTORY_SERVER_HOST=localhost
# Ports (this and FRM_WEB_PORT below) must be whole numbers from 1 to 65535, or the backend
# refuses to start.
SATISFACTORY_API_PORT=7777
# Optional. Only needed to change server settings from the dashboard (the auto-pause
# toggle, ADR-0012); without it the setting is shown read-only. Use an APPLICATION token:
# run `server.GenerateAPIToken` in the game server's console and paste the result here.
# Application tokens don't expire and are what third-party apps should use, not a
# password-login token (docs-vault/raw-sources/dedicated-server-api.md:279-284).
# `server.InvalidateAPITokens` revokes them (all of them). Never commit a real token.
SATISFACTORY_API_TOKEN=
# Vanilla API is always TLS-wrapped, with a self-signed cert by default. Leave unset:
# the cert is verified unless SATISFACTORY_SERVER_HOST is loopback or a private IP
# (a hostname other than localhost counts as public). Set true to always verify, or
# false to deliberately accept a self-signed cert from a non-private host, e.g. a game
# server reached over Tailscale (100.64.0.0/10 counts as public).
SATISFACTORY_API_REJECT_UNAUTHORIZED=
FRM_WEB_PORT=8080
FRM_AUTH_TOKEN=
# Per-request deadline for the game server, in whole milliseconds, 1000-60000. Anything else
# stops the backend from starting.
SATISFACTORY_REQUEST_TIMEOUT_MS=5000

# Address the backend listens on. Defaults to 127.0.0.1: it's reached only through the
# Cloudflare Tunnel on this machine (ADR-0013). Set 0.0.0.0 only in a container.
HOST=127.0.0.1

# pino log level: trace, debug, info (default), warn, error, fatal or silent.
# Logs are JSON lines on stdout (ADR-0008). Tests default to silent.
LOG_LEVEL=info

# --- Login (ADR-0011). The backend refuses to start if any of these is missing. ---
# One operator account. Put the HASH here, never the password: generate it with
#   npm run hash-password -w backend
DASHBOARD_ADMIN_USER=
DASHBOARD_ADMIN_PASSWORD_HASH=
# At least 32 random bytes (43+ base64 characters, not a placeholder), e.g.
# `openssl rand -base64 48`. The backend refuses to start with a weaker one. Changing it
# signs every session out: that is the emergency "revoke everything" (ADR-0019).
SESSION_SECRET=
# Exact origins allowed to call the API with credentials, comma-separated. Defaults to
# https://satis-manager.com (ADR-0013). Never "*". Not needed for local development:
# the Vite dev server proxies /api, so the browser sees one origin.
CORS_ALLOWED_ORIGINS=

# Google sign-in (ADR-0025 decisions 3 and 5). All four or none: leave them all empty and
# /api/auth/google/* answers 404; set only some and the backend refuses to start. Needs
# DATABASE_URL. The redirect URI is the exact URL registered in the Google Cloud Console
# (https, or http://localhost for development). BOOTSTRAP_OWNER_EMAIL is the one Google
# account that may claim the seeded operator on its first sign-in; every other account is
# refused (sign-up is closed). FRONTEND_ORIGIN (default https://satis-manager.com) must be
# one of CORS_ALLOWED_ORIGINS: every redirect after sign-in starts there.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
BOOTSTRAP_OWNER_EMAIL=
FRONTEND_ORIGIN=
