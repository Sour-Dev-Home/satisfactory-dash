PORT=3001

# Satisfactory dedicated server connection (see backend/src/adapters/config.ts)
SATISFACTORY_SERVER_HOST=localhost
SATISFACTORY_API_PORT=7777
SATISFACTORY_API_TOKEN=
# Vanilla API is always TLS-wrapped, self-signed by default. Leave false (the
# default) for a local/trusted-network server; set to true once a real cert chain is
# configured on the game server, e.g. for a non-local deployment.
SATISFACTORY_API_REJECT_UNAUTHORIZED=false
FRM_WEB_PORT=8080
FRM_AUTH_TOKEN=
SATISFACTORY_REQUEST_TIMEOUT_MS=5000

# pino log level: trace, debug, info (default), warn, error, fatal or silent.
# Logs are JSON lines on stdout (ADR-0008). Tests default to silent.
LOG_LEVEL=info
