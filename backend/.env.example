PORT=3001

# Optional: write logs to daily files (backend-YYYY-MM-DD.log) in this directory, keeping 14 days,
# instead of stdout. An absolute path; created if missing. See docs-vault/wiki/runbooks/go-live-api.md.
# LOG_DIR=
# Event loop diagnostic: once per 30 s window, log ONE warn `event_loop_stall` (max_ms, p99_ms, mean_ms)
# when the loop's worst delay exceeded this many ms (50-60000, default 500). Helps tell a machine-wide
# stall from this process being blocked.
# EVENT_LOOP_STALL_MS=500
# How long the purge worker (old sessions, login attempts, audit events) waits after the database startup
# check succeeded before its first run, in ms (0-600000, default 30000). The first connections of a new
# process can be slow on the Windows host (issue #153).
# PURGE_START_DELAY_MS=30000
# ADR-0056 PR 6b: the delivery metrics ingest (POST /api/internal/metrics/delivery). The hex SHA-256 of the
# bearer secret the daily workflow sends (64 hex digits), never the secret itself. Unset = the ingest is off
# (404) and the metrics page says the feed isn't set up. Needs a database. Never commit a real value.
# METRICS_INGEST_SECRET_SHA256=

# Postgres (ADR-0025). Optional until deploy A: unset or blank = no database. The runtime role is
# satis_app; see docs-vault/wiki/runbooks/database.md. Never commit a real value.
# Use 127.0.0.1, not localhost: on Windows localhost tries ::1 first, where a closed port answers EACCES (#298).
# DATABASE_URL=postgres://satis_app:CHANGE_ME@127.0.0.1:5432/satis
# DATABASE_POOL_MAX=10
# DATABASE_STATEMENT_TIMEOUT_MS=10000
# DATABASE_READINESS_TIMEOUT_MS=3000

# Game servers: none are configured here. Since ADR-0066 every server connects through the SatisDashAgent mod, which
# pushes to /agent/v1 after enrolment (docs-vault/wiki/runbooks/agents.md). The old SATISFACTORY_* and FRM_* variables
# and SATISFACTORY_SERVERS_FILE are no longer read; delete them from your .env.

# Address the backend listens on. Defaults to 127.0.0.1: it's reached only through the
# Cloudflare Tunnel on this machine (ADR-0013). Set 0.0.0.0 only in a container.
HOST=127.0.0.1

# pino log level: trace, debug, info (default), warn, error, fatal or silent.
# Logs are JSON lines on stdout (ADR-0008). Tests default to silent.
LOG_LEVEL=info

# --- Login (ADR-0011). The backend refuses to start if any of these is missing. ---
# One operator account. Put the HASH here, never the password: generate it with
#   npm run hash-password -w backend
DASHBOARD_ADMIN_USER=
DASHBOARD_ADMIN_PASSWORD_HASH=
# At least 32 random bytes (43+ base64 characters, not a placeholder), e.g.
# `openssl rand -base64 48`. The backend refuses to start with a weaker one. Changing it
# signs every session out: that is the emergency "revoke everything" (ADR-0019).
SESSION_SECRET=
# Seals stored secrets (AES-256-GCM, ADR-0030): the alert webhooks and web-push data, and the old game-server tokens
# left in servers.server_connections until ADR-0066 PR 10 drops that table. 32 random bytes as base64:
#   openssl rand -base64 32
# Unset is fine without webhooks or push; if set it is validated at startup and a bad value stops the backend. BACK IT UP OFFLINE like the age key: a restored database is unreadable
# without it. Never commit it.
SERVER_SECRETS_KEY=
# Optional rotation: the id stored with newly sealed values (default k1), and retired keys kept
# only so old rows stay readable, as `id=base64,id2=base64`.
SERVER_SECRETS_KEY_ID=
SERVER_SECRETS_PREVIOUS_KEYS=
# ADR-0027: alert delivery kill switch, `on` or `off` (default off). Off: alert events are still recorded in the
# alert log but nothing is queued or sent. On: new events are sent to the server's Discord webhook (needs DATABASE_URL
# and SERVER_SECRETS_KEY, the webhook is stored encrypted). Turning it on sends only events that happen AFTER that.
# Anything else stops the backend at startup.
ALERT_DELIVERY=off
# ADR-0044 web push. Set all three or none (anything else stops the backend at startup). Generate the key pair ONCE
# yourself (for example `npx web-push generate-vapid-keys`); the private key is a secret, never commit or paste it.
# Both keys are base64url without padding; the subject is a mailto: address or an https URL. Push also needs
# ALERT_DELIVERY=on, DATABASE_URL and SERVER_SECRETS_KEY. Rotating the keys invalidates every subscription.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.invalid
# Push-service hosts a subscription endpoint may use, comma-separated (an exact host or `*.suffix`); setting it REPLACES
# the default list (Google, Mozilla, Windows). Apple's host is not in the default: [NEEDS VERIFICATION], add it here once
# captured from a real device.
# PUSH_ENDPOINT_HOSTS=
# Exact origins allowed to call the API with credentials, comma-separated. Defaults to
# https://satis-manager.com (ADR-0013). Never "*". Not needed for local development:
# the Vite dev server proxies /api, so the browser sees one origin.
CORS_ALLOWED_ORIGINS=

# Google sign-in (ADR-0025 decisions 3 and 5). All four or none: leave them all empty and
# /api/auth/google/* answers 404; set only some and the backend refuses to start. Needs
# DATABASE_URL. The redirect URI is the exact URL registered in the Google Cloud Console
# (https, or http://localhost for development). BOOTSTRAP_OWNER_EMAIL is the one Google
# account that may claim the seeded operator on its first sign-in; every other account is
# refused (sign-up is closed). FRONTEND_ORIGIN (default https://satis-manager.com) must be
# one of CORS_ALLOWED_ORIGINS: every redirect after sign-in starts there.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
BOOTSTRAP_OWNER_EMAIL=
FRONTEND_ORIGIN=

# Open sign-up (ADR-0046, #528). SIGNUP_MODE is "closed" (default, or unset: an unknown Google account is
# refused) or "open" (any verified Google account may create an account after accepting the terms; needs
# the Google settings above). Anything else stops the backend at startup. SIGNUP_MAX_PER_HOUR is the C8
# cap on new accounts per hour for the whole process (1 to 1000, default 20). Turn it on only when the
# ADR-0046 release gates are closed; see docs-vault/wiki/runbooks/go-live-api.md.
SIGNUP_MODE=
SIGNUP_MAX_PER_HOUR=

# Self-serve agent servers (ADR-0046, #525): any signed-in account creates its own agent server with
# POST /api/servers/agent. SELF_SERVE_ENABLED is "false" (default, or unset: the route answers 403) or "true"
# (needs DATABASE_URL). The caps count self-serve servers only, and the operator's account is exempt:
#   SELF_SERVE_MAX_SERVERS_PER_ACCOUNT  C1, servers one account created (1 to 20, default 2)
#   SELF_SERVE_MAX_SERVERS_TOTAL        C2, live self-serve servers in total (1 to 1000, default 25)
#   SELF_SERVE_MAX_PENDING_PER_ACCOUNT  C3, never-enrolled servers one account created (1 to C1, default 1)
#   SELF_SERVE_CREATES_PER_DAY          C5, creations per account in any 24 h, counted in the database (1 to 100, default 5)
#   SELF_SERVE_PENDING_TTL_HOURS        C4, hours before a never-enrolled server is swept (1 to 168, default 24)
# Anything else stops the backend at startup. Only the operator changes these, here and with a restart (there
# is no API). Lowering a cap never deletes a server. Turn it on only when the ADR-0046 release gates are
# closed; see docs-vault/wiki/runbooks/agents.md.
SELF_SERVE_ENABLED=
SELF_SERVE_MAX_SERVERS_PER_ACCOUNT=
SELF_SERVE_MAX_SERVERS_TOTAL=
SELF_SERVE_MAX_PENDING_PER_ACCOUNT=
SELF_SERVE_CREATES_PER_DAY=
SELF_SERVE_PENDING_TTL_HOURS=

# Nightly database backup (ADR-0025 decision 7, docs-vault/wiki/runbooks/backups.md). `npm run backup -w backend`
# reads DATABASE_URL above plus these. BACKUP_AGE_RECIPIENT is a PUBLIC age key (age1...): the private key
# stays offline in your password manager, never on this PC. Leave BACKUP_S3_BUCKET empty for a local trial
# run that never touches AWS. The AWS credentials live in the named AWS CLI profile, never in this file.
BACKUP_AGE_RECIPIENT=
BACKUP_S3_BUCKET=
# Optional: dump as another role (e.g. the migrator) if pg_dump says "permission denied" as the app role.
BACKUP_DATABASE_URL=
# Optional missed-backup alerting: a Better Stack heartbeat URL, pinged after a really uploaded backup
# (10 s timeout; a failed ping never fails the backup). A SECRET: https only, never log or share it.
BACKUP_HEARTBEAT_URL=
# Optional: profile name (default satis-backup), local folder for encrypted copies (default
# %LOCALAPPDATA%\satisfactory-dash\backups) and how many to keep locally (default 3).
BACKUP_AWS_PROFILE=
# Optional: the https:// endpoint of an S3-compatible store that is not AWS S3 (Backblaze B2, ADR-0035). Passed to
# `aws s3 cp` as --endpoint-url. Empty = plain AWS S3, exactly as before. No credentials in it (they live in the profile).
BACKUP_S3_ENDPOINT=
BACKUP_LOCAL_DIR=
BACKUP_LOCAL_KEEP=
