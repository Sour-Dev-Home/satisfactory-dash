{
  "name": "frontend",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo",
    "typecheck": "tsc -b",
    "lint": "oxlint && node scripts/check-network-lint.mjs && node scripts/check-design-tokens.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "demo:video": "playwright test -c playwright.video.config.ts && node scripts/encode-demo-video.mjs",
    "assets:icons": "playwright test -c playwright.assets.config.ts icons",
    "assets:preview": "npm run build:demo && playwright test -c playwright.assets.config.ts preview",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.3",
    "@satisfactory-dash/shared": "*",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "leaflet": "1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@types/leaflet": "^1.9.22",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "markdown-it": "^15.0.3",
    "msw": "^3.0.4",
    "oxlint": "^1.92.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
