{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "no-restricted-globals": [
      "error",
      {
        "name": "fetch",
        "message": "Only src/api/transport.ts sends requests (ADR-0026: the demo build swaps it out). Use apiGet/apiSend."
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@satisfactory-dash/shared/fixtures", "@satisfactory-dash/shared/fixtures/*"],
            "message": "Fixtures are for tests and MSW mocks only (src/test/ and *.test.*), never production code."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/test/**", "e2e/**", "**/*.test.ts", "**/*.test.tsx"],
      "rules": { "no-restricted-imports": "off", "no-restricted-globals": "off" }
    },
    {
      "files": ["src/api/transport.ts"],
      "rules": { "no-restricted-globals": "off" }
    },
    {
      "files": ["e2e/**"],
      "rules": {
        "react/rules-of-hooks": "off",
        "no-empty-pattern": "off"
      }
    }
  ]
}
