# compose.yaml's settings (issue #406). Copy to .env next to compose.yaml and fill it in; .env is
# git-ignored. Never commit it. Runbook: docs-vault/wiki/runbooks/compose.md.
#
# Docker Compose reads $ in this file as a variable: wrap any value that holds $ (the password hash)
# in single quotes, e.g. DASHBOARD_ADMIN_PASSWORD_HASH='scrypt$...'.

# --- Database (local PostgreSQL 18). The passwords go inside postgres:// URLs, so use hex only:
#   openssl rand -hex 24
# The postgres superuser; used only by the migrate job's db:init.
POSTGRES_PASSWORD=
# satis_migrator (migrations) and satis_app (the backend). 16+ characters each, all three different.
DB_MIGRATOR_PASSWORD=
DB_APP_PASSWORD=

# --- Login (ADR-0011). Required: the backend refuses to start without them.
# The hash from `npm run hash-password -w backend`, single-quoted (it contains $).
DASHBOARD_ADMIN_USER=
DASHBOARD_ADMIN_PASSWORD_HASH=
# At least 32 random bytes: openssl rand -base64 48
SESSION_SECRET=

# --- Optional; empty means the backend's default. Meanings are in backend/.env.example.
SERVER_SECRETS_KEY=
SERVER_SECRETS_KEY_ID=
SERVER_SECRETS_PREVIOUS_KEYS=
ALERT_DELIVERY=
CORS_ALLOWED_ORIGINS=
FRONTEND_ORIGIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
BOOTSTRAP_OWNER_EMAIL=
LOG_LEVEL=

# --- Images. Empty means the GHCR images #404 publishes (tag main); set them to run other builds.
APP_IMAGE=
OPS_IMAGE=

# --- Tunnel (the `tunnel` profile only). The token from the Cloudflare dashboard's tunnel page.
TUNNEL_TOKEN=
