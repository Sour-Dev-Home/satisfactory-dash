# dependencies
node_modules/

# build output
dist/
build/

# env files (commit .env.example instead)
.env
.env.*
!.env.example

# retired per-server connection config with tokens (ADR-0025, retired by ADR-0066); still ignored so a leftover copy is never committed
backend/servers.json

# misc
.DS_Store
*.pem
*.tsbuildinfo

# logs
npm-debug.log*

# Structurizr exports from the architecture CI job (ADR-0024)
docs-vault/architecture-out/

# Database backups and their keys must never be committed (docs-vault/wiki/runbooks/backups.md)
*.dump
*.dump.age
*.age
*.key

# Terraform (infra/aws/, #405): provider caches, state, plans, and the real variable and backend files,
# which hold the alert address and bucket name. The .example files next to them are tracked.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfplan
*.tfbackend
crash.log

# The load kit (ADR-0037, #448): the seed's credentials (agent secrets, session ids) and raw k6 output.
# Reports are committed under docs-vault/wiki/perf/ instead.
load/.data/
load/results/
