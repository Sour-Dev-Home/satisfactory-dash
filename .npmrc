# Install-script policy (#561). npm 11.16+ refuses to install a dependency whose install scripts are not listed in
# package.json "allowScripts" (true = may run, false = skipped). Review a new one, then `npm approve-scripts <pkg>`
# (add --no-allow-scripts-pin so Dependabot bumps keep working) or `npm deny-scripts <pkg>`. Older npm ignores this.
strict-allow-scripts=true
