{
  "name": "@satisfactory-dash/agent",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "The edge agent (ADR-0031 PR 6): runs beside the game server, reads it over loopback and pushes snapshots out to the backend.",
  "type": "module",
  "main": "dist/agent.cjs",
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=cjs --outfile=dist/agent.cjs",
    "start": "node dist/agent.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "dependencies": {
    "@satisfactory-dash/game-adapter": "*",
    "@satisfactory-dash/shared": "*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
